# Copy to .env (gitignored) and fill in, or export these directly in your shell/MCP client config.

# Scoped API token from the Cloudflare dashboard (My Profile > API Tokens > Create Token).
# Needs Zone > DNS > Edit and Zone > Zone > Read, scoped to the specific zone(s) you want
# this server to manage. Never commit this — it's a long-lived credential.
CLOUDFLARE_API_TOKEN=

# Optional. Cloudflare account ID (Dashboard > right sidebar of any domain overview, or
# Workers & Pages overview). Only needed to filter list_zones to a single account when the
# token has access to more than one.
CLOUDFLARE_ACCOUNT_ID=
